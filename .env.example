# ==============================================================================
# toxtoe - Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env or .env.local containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/toxtoe?schema=public"

# Optional direct connection string for database migrations (e.g., Supabase / Neon / PgBouncer)
# DIRECT_URL="postgresql://postgres:password@localhost:5432/toxtoe?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS (Authentication)
# ------------------------------------------------------------------------------
# Secret used to sign and encrypt session cookies / JWT tokens.
# Generate one using: openssl rand -base64 32  OR  npx auth secret
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars-long"
AUTH_SECRET="your-nextauth-secret-key-at-least-32-chars-long"

# The canonical base URL for NextAuth callbacks in local development
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional - configure as needed for social logins)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# 3. STRIPE (Payments & Webhooks)
# ------------------------------------------------------------------------------
# Stripe Secret Key for server-side API calls (Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Stripe Publishable Key for client-side Stripe Elements / Checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Stripe Webhook Signing Secret for verifying event signatures (listen via `stripe listen`)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ------------------------------------------------------------------------------
# 4. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the marketplace application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
